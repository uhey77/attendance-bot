# .env.example をコピーして .env を作成し、各値を設定する（.env は Git 管理外）

# Slack
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
ALLOWED_TEAM_ID=T00000000
ALLOWED_USER_ID=U00000000
POST_CHANNEL_ID=C00000000
MENTION_USER_ID=U00000000

# 給与
HOURLY_RATE=
# 日本時間の深夜帯。倍率1で割増なし。
NIGHT_START_HOUR=22
NIGHT_END_HOUR=5
NIGHT_MULTIPLIER=1.25

# Google Apps Script
GAS_URL=https://script.google.com/macros/s/xxxxx/exec
GAS_SHARED_SECRET=
