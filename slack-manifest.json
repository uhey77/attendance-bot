{
  "display_information": {
    "name": "Work Tracker",
    "description": "Personal attendance tracking"
  },
  "features": {
    "bot_user": {
      "display_name": "Work Tracker",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/start",
        "url": "https://<your-worker>.<your-subdomain>.workers.dev/slack/commands",
        "description": "Start work",
        "should_escape": false
      },
      {
        "command": "/break",
        "url": "https://<your-worker>.<your-subdomain>.workers.dev/slack/commands",
        "description": "Start a break",
        "should_escape": false
      },
      {
        "command": "/resume",
        "url": "https://<your-worker>.<your-subdomain>.workers.dev/slack/commands",
        "description": "Resume work",
        "should_escape": false
      },
      {
        "command": "/end",
        "url": "https://<your-worker>.<your-subdomain>.workers.dev/slack/commands",
        "description": "Finish work",
        "should_escape": false
      },
      {
        "command": "/week",
        "url": "https://<your-worker>.<your-subdomain>.workers.dev/slack/commands",
        "description": "Completed work this week",
        "should_escape": false
      },
      {
        "command": "/month",
        "url": "https://<your-worker>.<your-subdomain>.workers.dev/slack/commands",
        "description": "Completed work this month",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
